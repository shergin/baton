{
  "schema": "../../spec/tests/schema.graphql",
  "schemaExtensions": ["live.graphql"],
  "customScalarTypes": { "Decimal": "Foundation.Decimal" },
  "transient": {
    "fields": ["Query.characterBy", "Query.liveCharacters"]
  },
  "lookups": [
    { "field": "Query.character", "type": "Character", "argument": "id" },
