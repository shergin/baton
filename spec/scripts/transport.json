      "sent": [{"operation": "TestPinnedCharacter", "body": "{\"operationName\":\"TestPinnedCharacter\",\"query\":\"query TestPinnedCharacter($id:ID!){character(id:$id){id,name,status}}\",\"variables\":{\"id\":\"1\"}}"}]
    },
    {
      "attach": {"operation": "TestCharactersWithStatus", "variables": {"status": "DEAD", "any": ["ALIVE", "UNKNOWN"]}, "policy": "networkOnly", "as": "dead", "failure": "transport"},
      "sent": [{"operation": "TestCharactersWithStatus", "body": "{\"operationName\":\"TestCharactersWithStatus\",\"query\":\"query TestCharactersWithStatus($status:Status!,$any:[Status!]){charactersWithStatus(status:$status,any:$any){name,id}}\",\"variables\":{\"any\":[\"ALIVE\",\"UNKNOWN\"],\"status\":\"DEAD\"}}"}]
