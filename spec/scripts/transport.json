    {
      "attach": {"operation": "TestPricedAssetsQuery", "variables": {"price": "19.99", "among": ["0.5", "100"]}, "policy": "networkOnly", "as": "priced", "failure": "transport"},
      "sent": [{"operation": "TestPricedAssetsQuery", "body": "{\"operationName\":\"TestPricedAssetsQuery\",\"query\":\"query TestPricedAssetsQuery($price:Decimal!,$among:[Decimal!]){assetsPricedAbove(price:$price,among:$among){uuid,...TestCaughtPrices_asset,...TestThrowingPrices_asset,...TestRequiredPrice_asset,id}}fragment TestCaughtPrices_asset on Asset{price,listedAt,page}fragment TestRequiredPrice_asset on Asset{price}fragment TestThrowingPrices_asset on Asset{price,prices}\",\"variables\":{\"among\":[\"0.5\",\"100\"],\"price\":\"19.99\"}}"}]
    },
    {
